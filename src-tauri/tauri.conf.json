{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskSentinelPro",
  "version": "4.5.0",
  "identifier": "com.disksentinel.pro",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiskSentinel Pro - 데스크톱 디스크 배드섹터 정밀 진단기",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
