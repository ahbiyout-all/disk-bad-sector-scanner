{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskBadSectorScanner",
  "version": "4.6.0",
  "identifier": "com.disksentinel.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Disk Bad Sector Scanner - 데스크톱 디스크 배드섹터 정밀 진단기",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bin/native/DiskSentinelNativeCore.dll": "DiskSentinelNativeCore.dll",
      "../bin/native/DiskSentinelForensics.dll": "DiskSentinelForensics.dll",
      "../bin/native/DiskSentinelPredictive.dll": "DiskSentinelPredictive.dll",
      "../bin/native/DiskSentinelRecovery.dll": "DiskSentinelRecovery.dll"
    }
  }
}
